# Copy to .env for local development. Never commit .env.
# In production these are set in the Cloudflare Worker's Variables & Secrets,
# not in a file.
#
# This site has its own provider accounts, separate from every other project.
# Nothing here is shared with softwiz.io — separate Cloudflare account,
# separate email sender, separate Search Console property.

# Email API key for the contact form. Without it the endpoint still returns
# success and logs the lead to the console, so the form stays testable locally.
CONTACT_API_KEY=

# Where leads are delivered. Comma-separated.
CONTACT_TO=yonatan@shamam.net

# Envelope sender. Must be on a domain verified with the email provider.
CONTACT_FROM=
