---
import type { Service } from '../data/services.ts';

/**
 * The service list, as an index rather than a card grid.
 *
 * A grid of white cards with shadows is the most generic container on the web,
 * and repeating it sixteen times is what made this site forgettable. This is
 * the same information set the way a legal document sets a list: numbered,
 * ruled, and given room. It also scans far faster at sixteen items than a grid
 * of equal-weight boxes does.
 */

interface Props {
  services: Service[];
  /** Where the numbering starts, so a page of sections keeps counting. */
  offset?: number;
}
const { services, offset = 0 } = Astro.props;

---
<ol class="index">
  {services.map((s, i) => (
    <li>
      <a href={`/practice-areas/${s.slug}/`}>
        <span class="num"><bdi dir="ltr">{String(offset + i + 1).padStart(2, '0')}</bdi></span>
        <span class="body">
          <span class="head">
            <span class="title">{s.shortTitle ?? s.title}</span>
            {s.tag && <span class:list={['tag', s.tagAccent && 'tag-accent']}>{s.tag}</span>}
          </span>
          <span class="sum">{s.summary}</span>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .index { border-block-start: 1px solid var(--ink); }
  .index li { border-block-end: 1px solid var(--rule); }

  a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s4);
    padding-block: var(--s4);
    text-decoration: none;
    transition: background-color .16s, padding-inline .16s;
  }
  a:hover { background: var(--surface); padding-inline: var(--s4); }
  @media (prefers-reduced-motion: reduce) { a:hover { padding-inline: 0; } }

  .num {
    font-size: var(--fs-small);
    font-weight: 200;
    /* 3.15:1 — see the note on .numeral in global.css. */
    color: var(--line-control);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  a:hover .num { color: var(--accent); }


  .head { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; }
  .title {
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  a:hover .title { color: var(--accent); }
  .sum {
    display: block;
    font-size: var(--fs-small);
    color: var(--muted);
    margin-block-start: var(--s2);
    max-width: 62ch;
  }

  .tag {
    font-size: var(--fs-micro);
    font-weight: 700;
    white-space: nowrap;
    border-radius: var(--r-pill);
    padding: 2px 10px;
    background: var(--page);
    color: var(--muted);
    border: 1px solid var(--rule);
  }
  .tag-accent {
    background: var(--accent-wash);
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 25%, transparent);
  }


  @media (max-width: 700px) {
    a { grid-template-columns: 2.2rem minmax(0, 1fr); gap: var(--s3); }
  }
</style>
