---
import { FIRM } from '../data/firm.ts';
import { CATEGORIES } from '../data/services.ts';
---
<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <p class="brand">{FIRM.name}<span>{FIRM.tagline}</span></p>
        <ul class="contact">
          {/* dir="ltr" inside <bdi> so the number cannot leak its direction
              into the surrounding Hebrew, and cannot be reordered by it. */}
          <li>טלפון: <bdi><a href={`tel:${FIRM.phone.tel}`} dir="ltr">{FIRM.phone.display}</a></bdi></li>
          <li>דוא״ל: <bdi><a href={`mailto:${FIRM.email}`} dir="ltr">{FIRM.email}</a></bdi></li>
          <li>{FIRM.address.full}</li>
          <li>{FIRM.hours.days}, <bdi dir="ltr">{FIRM.hours.open}–{FIRM.hours.close}</bdi></li>
        </ul>
      </div>

      <div>
        <h2>תחומי עיסוק</h2>
        <ul>
          {Object.entries(CATEGORIES).map(([key, c]) => (
            <li><a href={`/practice-areas/#${key}`}>{c.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2>מידע נוסף</h2>
        {/* These four anchors exist on the live site today and every footer
            link there points at the top of the page instead. Fixed here. */}
        <ul>
          <li><a href="/articles/">מאמרים</a></li>
          <li><a href="/terms-privacy-accessibility/#terms">תנאי שימוש</a></li>
          <li><a href="/terms-privacy-accessibility/#privacy">מדיניות פרטיות</a></li>
          <li><a href="/terms-privacy-accessibility/#accessibility">הצהרת נגישות</a></li>
          <li><a href="/terms-privacy-accessibility/#cookies">מדיניות Cookies</a></li>
        </ul>
      </div>
    </div>

    <p class="foot-legal">
      האמור באתר זה אינו מהווה ייעוץ משפטי ואינו תחליף לו, ואין להסתמך עליו בלא
      בדיקה פרטנית. גלישה באתר, פנייה דרך טופס יצירת קשר, שליחת הודעה או דוא״ל
      אינם יוצרים יחסי עורך־דין לקוח.
    </p>
  </div>
</footer>

<style>
  .site-foot {
    background: var(--surface);
    border-block-start: 1px solid var(--rule);
    padding-block: var(--s8) var(--s6);
    font-size: var(--fs-small);
  }
  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: var(--s7); }

  .brand { font-weight: 600; margin-block-end: var(--s4); line-height: 1.3; }
  .brand span { display: block; font-size: var(--fs-micro); font-weight: 400; color: var(--muted); }

  /* h2, not h4: these are top-level footer sections, and jumping two heading
     levels breaks the document outline. Size comes from the class. */
  .foot-grid h2 { font-size: var(--fs-caption); color: var(--muted); font-weight: 600; margin-block-end: var(--s4); }

  .foot-grid li { margin-block-end: var(--s2); color: var(--muted); }
  .foot-grid a { text-decoration: none; color: var(--muted); display: inline-block; padding-block: 4px; }
  .foot-grid a:hover { color: var(--accent); text-decoration: underline; }
  .contact li { color: var(--muted); }

  .foot-legal {
    margin-block-start: var(--s7);
    padding-block-start: var(--s5);
    border-block-start: 1px solid var(--rule);
    color: var(--faint);
    font-size: var(--fs-caption);
    max-width: 78ch;
  }

  @media (max-width: 820px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .foot-grid { grid-template-columns: 1fr; gap: var(--s6); } }
</style>
