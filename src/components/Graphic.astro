---
/**
 * Inline an SVG from public/graphics/ into the page.
 *
 * WHY INLINE, AND NOT <img src="...">
 *
 * An SVG loaded through <img> is an isolated document. CSS from the host page
 * does not cross into it, so `stroke="currentColor"` resolves against the SVG's
 * own root — which is black — rather than against the page's colour. Verified
 * in the browser: referenced that way, every one of these rendered black
 * instead of taking the accent.
 *
 * Inlining puts the markup in the page's own cascade, so a single `color` on an
 * ancestor retints the whole graphic, and the high-contrast accessibility
 * preference reaches it like everything else.
 *
 * WHY import.meta.glob AND NOT node:fs
 *
 * The Cloudflare adapter prerenders inside the Workers runtime, which has no
 * `node:fs` — reading the file at render time fails the build. import.meta.glob
 * is resolved by Vite at bundle time, so the SVG source is baked into the
 * output and nothing touches a filesystem at runtime.
 *
 * The files stay in public/ rather than src/ because texture-paper.svg is also
 * used as a CSS background-image and needs a real URL.
 *
 * These graphics are decorative. Each gets aria-hidden and focusable="false" —
 * the second because older SVG made inline graphics tabbable and some assistive
 * tech still honours it. Everything they illustrate is also said in text.
 */
const FILES = import.meta.glob<string>('../../public/graphics/*.svg', {
  eager: true,
  query: '?raw',
  import: 'default',
});

interface Props {
  /** File name without the extension, e.g. "cat-business". */
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

const key = `../../public/graphics/${name}.svg`;
const source = FILES[key];
if (!source) {
  // Fail the build rather than ship a silent gap where a graphic should be.
  throw new Error(
    `Graphic not found: public/graphics/${name}.svg. Available: ` +
      Object.keys(FILES)
        .map((k) => k.split('/').pop())
        .join(', ')
  );
}

const svg = source.trim().replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<span class:list={['graphic', className]} set:html={svg} />

<style>
  .graphic { display: inline-flex; }
  .graphic :global(svg) { width: 100%; height: 100%; display: block; }
</style>
