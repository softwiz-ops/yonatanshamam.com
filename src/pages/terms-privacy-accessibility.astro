---
import Base from '../layouts/Base.astro';
import { FIRM } from '../data/firm.ts';
import { Content, frontmatter } from '../content/pages/legal.md';

/*
 * Four binding documents on one page: terms of use, privacy policy,
 * accessibility statement, and a cookies/storage policy.
 *
 * These are AUTHORED, not migrated. The original WordPress text is preserved
 * at reference/legal-original.md for comparison, and scripts/migrate-legal.py
 * regenerates it there — it must never write to src/ again.
 *
 * They were rewritten on 27 Jul 2026 because the migrated text made two false
 * statements about this build: it declared Cookies, pixels and targeted
 * marketing that do not exist here, and its accessibility section was thinner
 * than Regulation 35 expects. Every factual claim in the new text was checked
 * against the built site: zero cookies, zero third-party requests, fonts
 * self-hosted, and localStorage used only for the accessibility preferences.
 *
 * If the site's behaviour changes, this document changes with it, in the same
 * commit. Adding an analytics tag, a pixel, an embedded video or a CDN font
 * makes section ד false the moment it ships.
 *
 * The four anchors — #terms #privacy #accessibility #cookies — are load
 * bearing: the footer links point at them, and on the live site every one of
 * those links pointed at the top of the page instead. Do not rename them.
 */

const sections = [
  { id: 'terms', label: 'תנאי שימוש' },
  { id: 'privacy', label: 'מדיניות פרטיות' },
  { id: 'accessibility', label: 'הצהרת נגישות' },
  { id: 'cookies', label: 'מדיניות Cookies' },
];

---
<Base title={`${frontmatter.title} | ${FIRM.name}`} description={frontmatter.description}>
  <div class="wrap lede">
    <h1>{frontmatter.title}</h1>
    <p class="updated">{frontmatter.updated}</p>

    {/*
      Rendered from src/data/firm.ts so the operator's particulars exist in one
      place. The document body states them too; if they ever diverge, firm.ts
      is the source and the body is the copy to fix.
    */}
    <dl class="operator">
      <dt>המפעיל ובעל מאגר המידע</dt>
      <dd>
        {FIRM.operator.person}, <bdi dir="ltr">{FIRM.operator.registration}</bdi>,
        הפועל בשם המסחרי {FIRM.operator.tradeName}
      </dd>
      <dt>כתובת</dt>
      <dd>{FIRM.address.full}</dd>
      <dt>יצירת קשר</dt>
      <dd>
        <bdi><a href={`tel:${FIRM.phone.tel}`} dir="ltr">{FIRM.phone.display}</a></bdi>
        {' · '}
        <bdi><a href={`mailto:${FIRM.email}`} dir="ltr">{FIRM.email}</a></bdi>
      </dd>
    </dl>

    <nav class="jump" aria-label="ניווט במסמך">
      {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </nav>
  </div>

  <div class="wrap doc">
    <Content />
  </div>
</Base>

<style>
  .lede { padding-block: var(--s8) var(--s6); border-block-end: 1px solid var(--ink); }
  h1 {
    font-size: clamp(34px, 5.6vw, 64px);
    font-weight: 200;
    letter-spacing: -0.03em;
    line-height: 1.06;
  }
  .updated { color: var(--muted); font-size: var(--fs-small); margin-block-start: var(--s3); }

  .operator {
    margin-block-start: var(--s5);
    padding: var(--s5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--s2) var(--s5);
    font-size: var(--fs-small);
    max-width: 72ch;
  }
  .operator dt { color: var(--muted); }
  .operator dd { margin: 0; }
  .operator a { color: var(--accent); display: inline-block; padding-block: 3px; }
  @media (max-width: 600px) {
    .operator { grid-template-columns: 1fr; gap: var(--s1); }
    .operator dd { margin-block-end: var(--s3); }
  }

  .jump { display: flex; flex-wrap: wrap; gap: var(--s2); margin-block-start: var(--s5); }
  .jump a {
    font-size: var(--fs-caption);
    font-weight: 600;
    text-decoration: none;
    color: var(--accent);
    background: var(--accent-wash);
    border-radius: var(--r-pill);
    padding: 7px 14px;
  }
  .jump a:hover { background: var(--accent); color: var(--accent-ink); }

  .doc { padding-block: var(--s7) var(--s9); max-width: 76ch; }

  /* The document carries its section anchors as empty spans; give them scroll
     offset so the sticky header does not cover the heading they precede. */
  .doc :global(span[id]) { display: block; scroll-margin-top: 96px; }
  .doc :global(h2) {
    font-size: var(--fs-section);
    font-weight: 200;
    letter-spacing: -0.025em;
    margin-block: var(--s8) var(--s5);
    padding-block-end: var(--s3);
    border-block-end: 1px solid var(--rule);
  }
  .doc :global(h2:first-of-type) { margin-block-start: 0; }
  .doc :global(h3) { font-size: var(--fs-title); font-weight: 600; margin-block: var(--s6) var(--s3); }
  .doc :global(p) { margin-block-end: var(--s4); }
  .doc :global(ul), .doc :global(ol) { margin-block-end: var(--s5); padding-inline-start: var(--s5); }
  .doc :global(li) { margin-block-end: var(--s2); list-style: disc; }
  .doc :global(ol li) { list-style: decimal; }
  /* Links inside the prose — phone, email, external references — inherit the
     line box and land at ~23px tall, under the 24px target minimum. Padding
     lifts them without disturbing the paragraph rhythm. */
  .doc :global(a) { color: var(--accent); display: inline-block; padding-block: 3px; }
  .doc :global(strong) { font-weight: 600; }
  .doc :global(table) {
    width: 100%; border-collapse: collapse; margin-block-end: var(--s5); font-size: var(--fs-small);
  }
  .doc :global(th), .doc :global(td) {
    text-align: start; padding: var(--s3); border-block-end: 1px solid var(--rule); vertical-align: top;
  }
  .doc :global(th) { font-weight: 600; color: var(--muted); }
  .doc :global(code) {
    font-family: ui-monospace, monospace; font-size: .9em;
    background: var(--page); border: 1px solid var(--rule);
    border-radius: var(--r-sm); padding: 1px 5px;
  }
</style>
