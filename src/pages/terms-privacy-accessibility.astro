---
import Base from '../layouts/Base.astro';
import { FIRM } from '../data/firm.ts';
import { compiledContent, frontmatter } from '../content/pages/legal.md';

/*
 * Four binding documents on one page, migrated from the live site by
 * scripts/migrate-legal.py. Roughly 1,485 words of real Hebrew legal drafting,
 * updated February 2026 and already carrying the Amendment 13 changes.
 *
 * The four anchors — #terms #privacy #accessibility #cookies — are load
 * bearing: the footer links point at them, and on the live site every one of
 * those links pointed at the top of the page instead. Do not rename them.
 *
 * The URL is no longer /privacy-policy/. The document is terms + privacy +
 * accessibility + cookies, and burying an accessibility declaration under a
 * privacy URL works against Regulation 35, which expects it to be prominent
 * and findable. The old URL 301s here.
 *
 * TWO STATEMENTS IN THIS DOCUMENT ARE NOT YET TRUE OF THIS SITE:
 *   1. It claims IS 5568 AA and WCAG 2.1 AA. On the live WordPress site that
 *      rests on an accessibility overlay, which does not deliver it. This
 *      rebuild is built to AA in code, which is what makes the claim true —
 *      but it must be re-verified before launch.
 *   2. The cookies section declares pixels and targeted marketing. This build
 *      loads no analytics and no pixels at all. That section has to be
 *      rewritten to match actual behaviour before launch, or the document is
 *      false in the other direction.
 */

const sections = [
  { id: 'terms', label: 'תנאי שימוש' },
  { id: 'privacy', label: 'מדיניות פרטיות' },
  { id: 'accessibility', label: 'הצהרת נגישות' },
  { id: 'cookies', label: 'מדיניות Cookies' },
];

/**
 * The migrated declaration says only "משרדנו ממוקם בתל אביב. הנחיות גישה פיזית
 * יסופקו בתיאום מוקדם", which does not meet what Regulation 35 expects: the
 * declaration has to describe the premises as they are.
 *
 * The detail is injected into that section rather than appended as a separate
 * block, because splitting an accessibility declaration across two places is
 * exactly the findability problem the regulation is aimed at. It is injected
 * at build time rather than written into the Markdown because
 * migrate-legal.py overwrites that file on every run.
 */
const A = FIRM.physicalAccess;
const yesNo = (v: boolean | null, yes: string, no: string) =>
  v === null
    ? '<span class="todo">[[חסר: טרם נמסר]]</span>'
    : v
      ? yes
      : no;

const physicalAccess = `
<ul class="access">
  <li>${yesNo(A.parking, 'חניה נגישה זמינה במקום.', '<strong>אין חניה במקום.</strong>')}</li>
  <li>${yesNo(A.approach, 'קיימת דרך גישה נגישה אל המשרד.', 'אין דרך גישה נגישה.')}</li>
  <li>כניסה לבניין: ${yesNo(A.entrance, 'נגישה.', 'אינה נגישה.')}</li>
  <li>מעלית: ${yesNo(A.lift, 'קיימת ונגישה.', 'אין מעלית.')}</li>
  <li>${yesNo(A.toilets, 'קיימים שירותים נגישים.', 'אין שירותים נגישים.')}</li>
  <li>${yesNo(A.meetingRooms, 'חדרי הפגישות נגישים.', 'חדרי הפגישות אינם נגישים.')}</li>
</ul>
<p>ניתן לתאם מראש פגישה בסביבה נגישה, שירות בכתב או פגישה מרחוק.</p>
`;

/**
 * The preferences panel, described accurately.
 *
 * Note the framing: it is listed as an addition, and the sentence after it says
 * plainly that conformance rests on the code. An accessibility declaration that
 * points at a widget as the basis for conformance is making the same claim the
 * FTC fined accessiBe a million dollars for.
 */
// Anchored on the end of the adaptations list, so the new item is appended
// inside the <ul> and the qualifying paragraph lands after it.
const PANEL_ANCHOR = 'הימנעות מאנימציות והבהובים שעלולים לגרום לפרכוסים.</li>\n</ul>';
const panelNote = `הימנעות מאנימציות והבהובים שעלולים לגרום לפרכוסים.</li>
<li>פאנל העדפות נגישות: הגדלת טקסט, ניגודיות גבוהה, הדגשת קישורים ועצירת אנימציות. ההעדפות נשמרות במכשיר המשתמש בלבד ואינן נשלחות לאף גורם.</li>
</ul>
<p>הפאנל הוא תוספת נוחות בלבד. העמידה בתקן נשענת על מבנה האתר ועל הקוד שלו ולא על הפאנל, ואין בו כדי להחליף התאמת נגישות ברמת הקוד.</p>`;

const ANCHOR = 'הנחיות גישה פיזית יסופקו בתיאום מוקדם.';
let html = await compiledContent();

if (html.includes(PANEL_ANCHOR)) {
  // panelNote already restates the anchor text — it is a replacement for the
  // whole matched run, not something appended to it.
  html = html.replace(PANEL_ANCHOR, panelNote);
} else {
  throw new Error(
    'legal.md no longer contains the adaptations-list anchor; the preferences ' +
      'panel would go undeclared. Re-check migrate-legal.py output.'
  );
}

if (html.includes(ANCHOR)) {
  html = html.replace(ANCHOR, ANCHOR + '</p>' + physicalAccess + '<p>');
} else {
  // Fail loudly rather than silently shipping a declaration missing the
  // premises detail the regulation requires.
  throw new Error(
    'legal.md no longer contains the physical-access anchor sentence; ' +
      'the accessibility detail would be dropped. Re-check migrate-legal.py output.'
  );
}
---
<Base title={`${frontmatter.title} | ${FIRM.name}`} description={frontmatter.description}>
  <div class="wrap lede">
    <h1>{frontmatter.title}</h1>
    <p class="updated">{frontmatter.updated}</p>

    {/*
      Rendered from src/data/firm.ts rather than written into the Markdown,
      because migrate-legal.py overwrites that file and a hand-edit would be
      lost on the next run.

      The migrated document names only the trade name as "בעל מאגר המידע".
      Amendment 13 expects the controller to be identified with real
      particulars, so the registered person and registration number are stated
      here, at the head of the document that makes the claim.
    */}
    <dl class="operator">
      <dt>המפעיל ובעל מאגר המידע</dt>
      <dd>
        {FIRM.operator.person}, <bdi dir="ltr">{FIRM.operator.registration}</bdi>,
        הפועל בשם המסחרי {FIRM.operator.tradeName}
      </dd>
      <dt>כתובת</dt>
      <dd>{FIRM.address.full}</dd>
      <dt>יצירת קשר</dt>
      <dd>
        <bdi><a href={`tel:${FIRM.phone.tel}`} dir="ltr">{FIRM.phone.display}</a></bdi>
        {' · '}
        <bdi><a href={`mailto:${FIRM.email}`} dir="ltr">{FIRM.email}</a></bdi>
      </dd>
    </dl>

    <nav class="jump" aria-label="ניווט במסמך">
      {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </nav>
  </div>

  <div class="wrap doc" set:html={html} />
</Base>

<style>
  .lede { padding-block: var(--s7) var(--s6); border-block-end: 1px solid var(--rule); }
  h1 { font-size: clamp(28px, 4vw, 42px); font-weight: 400; letter-spacing: -0.015em; }
  .updated { color: var(--muted); font-size: var(--fs-small); margin-block-start: var(--s3); }

  .operator {
    margin-block-start: var(--s5);
    padding: var(--s5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--s2) var(--s5);
    font-size: var(--fs-small);
    max-width: 72ch;
  }
  .operator dt { color: var(--muted); }
  .operator dd { margin: 0; }
  .operator a { color: var(--accent); display: inline-block; padding-block: 3px; }
  @media (max-width: 600px) {
    .operator { grid-template-columns: 1fr; gap: var(--s1); }
    .operator dd { margin-block-end: var(--s3); }
  }

  .jump { display: flex; flex-wrap: wrap; gap: var(--s2); margin-block-start: var(--s5); }
  .jump a {
    font-size: var(--fs-caption);
    font-weight: 600;
    text-decoration: none;
    color: var(--accent);
    background: var(--accent-wash);
    border-radius: var(--r-pill);
    padding: 7px 14px;
  }
  .jump a:hover { background: var(--accent); color: var(--accent-ink); }

  .doc { padding-block: var(--s7) var(--s9); max-width: 76ch; }

  /* The migrated Markdown carries its own anchors as empty spans; give them
     scroll offset so the sticky header does not cover the heading. */
  .doc :global(span[id]) { display: block; scroll-margin-top: 96px; }
  .doc :global(h2) {
    font-size: var(--fs-section);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-block: var(--s8) var(--s5);
    padding-block-end: var(--s3);
    border-block-end: 1px solid var(--rule);
  }
  .doc :global(h2:first-of-type) { margin-block-start: 0; }
  .doc :global(h3) { font-size: var(--fs-title); font-weight: 600; margin-block: var(--s6) var(--s3); }
  .doc :global(p) { margin-block-end: var(--s4); }
  .doc :global(ul), .doc :global(ol) { margin-block-end: var(--s5); padding-inline-start: var(--s5); }
  .doc :global(li) { margin-block-end: var(--s2); list-style: disc; }
  .doc :global(ol li) { list-style: decimal; }
  /* Links inside the migrated prose — phone, email, external references —
     inherit the line box and land at ~23px tall, under the 24px target
     minimum. Padding lifts them without disturbing the paragraph rhythm. */
  .doc :global(a) { color: var(--accent); display: inline-block; padding-block: 3px; }
  .doc :global(strong) { font-weight: 600; }
  .doc :global(.access) { margin-block-end: var(--s5); padding-inline-start: var(--s5); }
  .doc :global(.access li) { list-style: disc; margin-block-end: var(--s2); }
</style>
