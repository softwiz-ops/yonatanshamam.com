---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { FIRM, whatsappLink } from '../data/firm.ts';
import { SERVICES, CATEGORIES, byCategory, type Category } from '../data/services.ts';

/*
 * Redesigned 27 Jul 2026, after the founder called the previous version generic
 * and boring. He was right, and the diagnosis matters more than the fix: the
 * page was a grid of white cards with shadows, which is the most-repeated
 * container on the web, and the type scale was so narrow that nothing on the
 * page had rank.
 *
 * The treatment now is editorial. The real asset here is sixteen pages of long
 * Hebrew explanation, so the site is set like a publication rather than a
 * service brochure: hairline rules instead of card borders, a numbered index
 * instead of a grid, a display size that actually uses the 200-800 weight range
 * Hebrew leaves as almost its only hierarchy tool, and the mark given enough
 * room to read as a mark.
 */

const faqs = [
  {
    q: 'מתי בכלל צריך עורך דין, ומתי אפשר להסתדר לבד?',
    a: 'ככלל, כשיש מסמך שמחייב אתכם לאורך זמן, כשהסכום משמעותי ביחס אליכם, או כשהצד השני הוא מי שניסח את המסמך. חוזה שכירות, צוואה, עסקת דירה והסכם בין שותפים נכנסים לקטגוריה הזו כמעט תמיד. יש גם דברים שאפשר באמת לעשות לבד, ואם זה המצב אומר לכם את זה.',
  },
  {
    q: 'אתם עובדים גם עם אנשים פרטיים, או רק עם עסקים?',
    a: 'שניהם. חלק מהעבודה היא ליווי חברות ומיזמים, וחלק גדול הוא אנשים פרטיים: צוואות, ירושות, חוזי שכירות ועסקאות דירה. אלה קהלים שונים, אבל השאלה זהה — מה בדיוק כתוב במסמך, ומה זה אומר עליכם.',
  },
  {
    q: 'קיבלתי חוזה וביקשו שאחתום מהר. אפשר לשלוח לבדיקה?',
    a: 'כן, וזה הזמן הנכון. לפני החתימה עדיין יש כוח מיקוח ואפשר לבקש שינויים; אחרי החתימה, סעיף בעייתי הוא כבר עובדה. לחץ לחתום מהר הוא בדרך כלל סיבה טובה יותר לבדוק, לא פחות.',
  },
  {
    q: 'אני לא בטוח שזה התחום שלכם. שווה לפנות?',
    a: 'שווה. אם הנושא אינו בתחומי העיסוק של המשרד אומר זאת מיד ואפנה אתכם למי שכן מטפל בו. זה חוסך לכם זמן, וזו גם הדרך הנכונה לעבוד.',
  },
  {
    q: 'מה קורה בפנייה הראשונה?',
    a: 'מדברים על מה שצריך: מה המסמך, מי הצד השני, ומה חשוב לכם שיקרה. בסוף השיחה תדעו מה האפשרויות ומה השלב הבא — גם אם המסקנה היא שאין צורך בעורך דין.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const ORDER: Category[] = ['contracts', 'estate', 'property', 'business', 'enforcement'];
let running = 0;
const groups = ORDER.map((key) => {
  const items = byCategory(key);
  const group = { key, items, offset: running };
  running += items.length;
  return group;
});
---
<Base
  title="עו״ד יהונתן שמם | משפט בגובה העיניים, תל אביב"
  description="משרד עורכי דין בתל אביב לעסקים ולאנשים פרטיים: חוזים, צוואות וירושה, נדל״ן ושכירות, הקמת חברות ומכתבי התראה. הסבר בשפה ברורה על מה שאתם חותמים עליו."
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="eyebrow">משרד עורכי דין · תל אביב</p>
        <h1>משפט<br /><strong>בגובה העיניים</strong></h1>
        <p class="sub">
          חוזים, צוואות וירושה, נדל״ן וליווי שוטף של חברות — לעסקים ולאנשים
          פרטיים. העבודה מתחילה בהסבר: מה המסמך עושה, מה הוא לא עושה, ואיפה
          הסיכון האמיתי.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={whatsappLink('שלום, הגעתי מהאתר ורציתי לשאול לגבי')}>כתבו לי בוואטסאפ</a>
          <a class="btn btn-ghost" href={FIRM.calendar}>תיאום פגישה ביומן</a>
        </div>
      </div>

      {/* THE PORTRAIT WAS REMOVED ON 5 AUG 2026, at the founder's decision, and
          should not be reinstated with the current file. The only original is
          640x800 and soft at native resolution — the head measures roughly
          150x200px, which is already 1:1 at a 160px slot on a 2x display, so
          there is no reserve for a denser screen or any browser zoom. Five
          rounds of pipeline work (build-time resizing, an unsharp mask at the
          delivered size, AVIF quality raised off Astro's default 50) each
          improved it measurably and none of it was enough, because no encoder
          setting invents detail that was never captured.

          scripts/build-portrait.py and reference/photos/ are kept deliberately:
          with a full-resolution original this becomes a one-command restore.
          A site with no photograph reads as composed. One with a soft
          photograph reads as neglected, which is worse.

          What carries the card instead is the record — every line permitted by
          the Bar's closed list: admission year, previous legal positions,
          degree, languages, city. No comparison and no superlative. */}
      <aside class="hero-card">
        <p class="hero-name">עו״ד יהונתן שמם</p>
        <p class="hero-role">{FIRM.tagline}</p>
        <dl class="hero-facts">
          <div><dt>הסמכה</dt><dd><bdi dir="ltr">{FIRM.admittedYear}</bdi></dd></div>
          {FIRM.previousRoles.map((r) => (
            <div>
              <dt>{r.role}</dt>
              <dd>{r.org}</dd>
            </div>
          ))}
          {FIRM.education?.[0] && (
            <div>
              <dt>השכלה</dt>
              <dd>{FIRM.education[0].institution}</dd>
            </div>
          )}
          <div><dt>שפות</dt><dd>{FIRM.languages.join(', ')}</dd></div>
          <div><dt>משרד</dt><dd>{FIRM.address.city}</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <div class="spread">
        <div class="rail-label">
          <span class="numeral">01</span>
          תחומי עיסוק
        </div>
        <div>
          <h2 class="section-title">השירותים שלנו</h2>
          <p class="section-lead">
            המשרד מטפל בחוזים והסכמים, בצוואות וירושה, בעסקאות נדל״ן ובליווי
            שוטף של חברות ועסקים. לכל נושא עמוד ייעודי עם הסבר מפורט.
          </p>

          {/* Five compact groups, not sixteen equal rows. The full index
              lives on /practice-areas/ — showing everything here read as a
              grocery list, which is exactly what it was. */}
          <div class="groups">
            {groups.map(({ key, items }) => (
              <section class="group">
                <h3>{CATEGORIES[key].title}</h3>
                <p class="blurb">{CATEGORIES[key].blurb}</p>
                <ul class="topics">
                  {items.map((s) => (
                    <li><a href={`/practice-areas/${s.slug}/`}>{s.shortTitle ?? s.title}</a></li>
                  ))}
                </ul>
              </section>
            ))}
          </div>

          <a class="all-link" href="/practice-areas/">
            כל תחומי העיסוק, עם הסבר על כל אחד
            <svg class="chev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="firm">
    <div class="wrap spread">
      <div class="rail-label"><span class="numeral">02</span>המשרד</div>
      {/* This band used to repeat the portrait and the biography, both of which
          now sit in the hero card a screen above. Repetition is what made the
          page feel thin. It carries the working method instead — the one thing
          here a competitor cannot copy by editing their own copy, because it is
          a commitment rather than a claim. */}
      <div class="firm-in">
        <div class="firm-copy">
          <h2>מה שאתם מקבלים לפני שאתם מחליטים</h2>
          <p class="firm-statement">
            לפני מתן המלצה אנו מציגים את התמונה המלאה: מה המסמך מסדיר, מה הוא
            אינו מסדיר, ומה החשיפה המעשית בכל אפשרות.
          </p>
          <a class="firm-link" href="/about/">
            אודות המשרד ושיטת העבודה
            <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        <ul class="firm-points">
          <li>
            <b>גם כשהתשובה היא שאין צורך בעורך דין</b>
            <span>זו התשובה שתינתן. במקרים לא מעטים ההסבר עצמו הוא מה שמייתר את העבודה.</span>
          </li>
          <li>
            <b>וגם כשהנושא לא בתחומי העיסוק</b>
            <span>נאמר זאת מיד ונפנה לגורם המתאים, במקום ללמוד את התחום על חשבונכם.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="spread">
        <div class="rail-label">
          <span class="numeral">03</span>
          למי זה מיועד
        </div>
        <div class="forks">
          <a class="fork" href="/practice-areas/#estate">
            <Icon name="scroll" size={24} class="fork-ico" />
            <h3>עניין אישי</h3>
            <p>צוואה, ירושה, חוזה שכירות, עסקת דירה, או חוזה שקיבלתם וצריך לקרוא לפני שחותמים.</p>
            <span class="go">לנושאים האישיים <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
          <a class="fork" href="/practice-areas/#business">
            <Icon name="buildings" size={24} class="fork-ico" />
            <h3>עסק, חברה או מיזם</h3>
            <p>הקמת חברה, הסכם בין שותפים, התקשרויות מול ספקים ולקוחות, ותקנוני אתר ופרטיות.</p>
            <span class="go">לנושאים העסקיים <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <div class="spread">
        <div class="rail-label">
          <span class="numeral">04</span>
          שאלות נפוצות
        </div>
        {/* The accordion keeps a reading measure, so on a wide screen it left
            roughly 400px of the track empty. The contact block fills it and
            puts a conversion point next to the questions people are still
            deciding on, which is where it is worth the most. */}
        <div class="faq-in">
          <Faq items={faqs} />
          <aside class="faq-aside">
            <h2>לא מצאתם את השאלה שלכם?</h2>
            <p>משפט אחד על מה שאתם צריכים מספיק כדי להתחיל. אם זה לא מתאים למשרד, נגיד את זה מיד.</p>
            <div class="faq-cta">
              <a class="btn btn-primary" href={whatsappLink('שלום, יש לי שאלה שלא מופיעה באתר')}>כתבו לי בוואטסאפ</a>
              <a class="btn btn-ghost" href={FIRM.calendar}>תיאום פגישה ביומן</a>
            </div>
            <dl class="faq-facts">
              <div><dt>טלפון</dt><dd><bdi><a href={`tel:${FIRM.phone.tel}`} dir="ltr">{FIRM.phone.display}</a></bdi></dd></div>
              <div><dt>שעות</dt><dd>{FIRM.hours.days}, <bdi dir="ltr">{FIRM.hours.open}–{FIRM.hours.close}</bdi></dd></div>
              <div><dt>משרד</dt><dd>{FIRM.address.full}</dd></div>
            </dl>
          </aside>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- faq ---------- */
  .faq-in { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: var(--s8); align-items: start; }
  .faq-aside {
    position: sticky;
    top: 96px;
    padding: var(--s6);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
  }
  .faq-aside h2 { font-size: var(--fs-title); font-weight: 600; letter-spacing: -0.015em; }
  .faq-aside p { color: var(--muted); font-size: var(--fs-small); margin-block-start: var(--s3); line-height: 1.6; }
  .faq-cta { display: grid; gap: var(--s3); margin-block-start: var(--s5); }
  .faq-facts { margin-block-start: var(--s5); font-size: var(--fs-caption); }
  .faq-facts > div { padding-block: var(--s3); border-block-start: 1px solid var(--rule); }
  .faq-facts dt { color: var(--muted); }
  .faq-facts dd { margin: 0; margin-block-start: 2px; }
  .faq-facts a { color: var(--accent); }

  @media (max-width: 940px) {
    .faq-in { grid-template-columns: 1fr; gap: var(--s6); }
    .faq-aside { position: static; }
  }

  /* ---------- hero ---------- */
  .hero { padding-block: clamp(40px, 6vw, 80px) var(--s8); }
  .hero-in { display: flex; align-items: stretch; gap: var(--s8); }
  .hero-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
  /* A column flex container stretches its children, which turned the eyebrow
     pill into a full-width bar. It sizes to its text. */
  .hero-copy > .eyebrow { align-self: flex-start; }

  h1 {
    font-size: var(--fs-display);
    font-weight: 200;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-block-start: var(--s5);
  }
  h1 strong { font-weight: 700; }
  .sub {
    font-size: var(--fs-lead);
    color: var(--muted);
    max-width: 44ch;
    margin-block-start: var(--s6);
    line-height: 1.6;
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--s3); margin-block-start: var(--s7); }

  /* The credential card. A bordered panel is used here and almost nowhere else
     on the site, because this is the one block that has to read as a distinct
     object rather than as more page. */
  .hero-card {
    flex: none;
    width: 260px;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--s6);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
  }
  .hero-name {
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .hero-role { font-size: var(--fs-caption); color: var(--muted); margin-block-start: var(--s1); }

  .hero-facts {
    width: 100%;
    margin-block-start: var(--s5);
    font-size: var(--fs-caption);
  }
  .hero-facts > div {
    display: flex;
    justify-content: space-between;
    gap: var(--s3);
    padding-block: var(--s3);
    border-block-start: 1px solid var(--rule);
  }
  .hero-facts dt { color: var(--muted); }
  .hero-facts dd { margin: 0; font-weight: 600; text-align: start; }

  /* ---------- sections ---------- */
  .section-title {
    font-size: var(--fs-section);
    font-weight: 200;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .section-lead {
    color: var(--muted);
    max-width: 56ch;
    margin-block: var(--s4) var(--s8);
    font-size: var(--fs-lead);
    line-height: 1.6;
  }

  /* Two columns across the full content track. The previous single stacked
     column left roughly 400px of the 936px empty on every row, and the topic
     names ran along one line separated by pipes — which is the grocery list the
     founder rejected in the navigation, rebuilt here by accident. */
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s6) var(--s7);
    margin-block-start: var(--s6);
  }
  .group { padding-block-start: var(--s5); border-block-start: 1px solid var(--ink); }
  .group h3 { font-size: var(--fs-title); font-weight: 600; letter-spacing: -0.015em; }
  .blurb { color: var(--muted); font-size: var(--fs-small); margin-block-start: var(--s2); }

  /* One topic per line. A name plus its own row is scannable; sixteen names
     wrapped inline is not. */
  .topics { margin-block-start: var(--s4); }
  .topics li + li { border-block-start: 1px solid var(--rule); }
  .topics a {
    display: block;
    font-size: var(--fs-small);
    text-decoration: none;
    color: var(--ink);
    padding-block: var(--s3);
    transition: color .14s;
  }
  .topics a:hover { color: var(--accent); }

  /* Five categories in two columns leaves the fifth alone with a hole beside
     it. It spans instead, and lays its topics along a row — which also gives
     the section an ending rather than stopping mid-grid. */
  .group:last-child { grid-column: 1 / -1; }
  .group:last-child .topics { display: flex; flex-wrap: wrap; gap: 0 var(--s6); }
  .group:last-child .topics li { border-block-start: 0; }
  .group:last-child .topics a { padding-block: var(--s2); }

  @media (max-width: 860px) {
    .groups { grid-template-columns: 1fr; }
    .group:last-child .topics { display: block; }
    .group:last-child .topics li + li { border-block-start: 1px solid var(--rule); }
    .group:last-child .topics a { padding-block: var(--s3); }
  }

  /* ---------- differentiator ---------- */
  .firm { background: var(--ink); color: #fff; }
  .firm :global(.wrap) { padding-block: var(--s9); }
  .firm :global(.rail-label) { color: #8d938f; }
  .firm :global(.numeral) { color: #666d68; }  /* 3.18:1 on the ink band */
  /* Two tracks across the full content width. The statement carries the weight;
     the two commitments sit beside it rather than under it, so the band reads
     as one idea instead of a stack. */
  .firm-in { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--s7) var(--s8); align-items: start; }
  .firm-copy h2 { font-size: var(--fs-section); font-weight: 200; letter-spacing: -0.025em; }
  /* #c3c8c5 on #1b1d1f measures 10.1:1 */
  .firm-copy p { color: #c3c8c5; margin-block-start: var(--s4); max-width: 46ch; }
  .firm-statement { font-size: var(--fs-lead); line-height: 1.6; }

  .firm-points { display: grid; gap: var(--s5); padding-block-start: var(--s3); }
  .firm-points li { border-block-start: 1px solid rgba(255, 255, 255, .18); padding-block-start: var(--s4); }
  .firm-points b { display: block; font-weight: 600; }
  .firm-points span { display: block; color: #c3c8c5; font-size: var(--fs-small); margin-block-start: var(--s2); line-height: 1.6; }
  .firm-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    margin-block-start: var(--s5);
    color: #fff;
    font-weight: 600;
    font-size: var(--fs-small);
    text-decoration: none;
    padding-block: 6px;
    border-block-end: 1px solid rgba(255, 255, 255, .4);
  }
  .firm-link:hover { border-block-end-color: #fff; }



  .divider { width: 240px; color: var(--line-control); margin-block-end: var(--s6); }

  .all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    margin-block-start: var(--s7);
    color: var(--accent);
    font-weight: 600;
    font-size: var(--fs-small);
    text-decoration: none;
    padding-block: 6px;
  }
  .all-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .forks { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .fork {
    padding: var(--s6) var(--s6) var(--s6) 0;
    text-decoration: none;
    border-block-start: 1px solid var(--ink);
  }
  .fork + .fork {
    border-inline-start: 1px solid var(--rule);
