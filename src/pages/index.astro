---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Faq from '../components/Faq.astro';
import Graphic from '../components/Graphic.astro';
import { FIRM, whatsappLink } from '../data/firm.ts';
import { SERVICES } from '../data/services.ts';

/*
 * Rewritten 27 Jul 2026. The previous home page led with speed and carried a
 * four-step process rail. Both are gone at the founder's instruction — a law
 * firm that advertises turnaround reads as a document mill, and the timings
 * were commitments nobody had approved.
 *
 * What leads instead is what he chose: משפט בגובה העיניים. It is the only
 * differentiator left once price and speed are both off the table, and it is
 * also the right content strategy — pages that genuinely explain are what rank
 * and what a generative engine can quote.
 */

const faqs = [
  {
    q: 'מתי בכלל צריך עורך דין, ומתי אפשר להסתדר לבד?',
    a: 'ככלל, כשיש מסמך שמחייב אתכם לאורך זמן, כשהסכום משמעותי ביחס אליכם, או כשהצד השני הוא מי שניסח את המסמך. חוזה שכירות, צוואה, עסקת דירה והסכם בין שותפים נכנסים לקטגוריה הזו כמעט תמיד. יש גם דברים שאפשר באמת לעשות לבד, ואם זה המצב אומר לכם את זה.',
  },
  {
    q: 'אתם עובדים גם עם אנשים פרטיים, או רק עם עסקים?',
    a: 'שניהם. חלק מהעבודה היא ליווי חברות ומיזמים, וחלק גדול הוא אנשים פרטיים: צוואות, ירושות, חוזי שכירות ועסקאות דירה. אלה קהלים שונים, אבל השאלה זהה — מה בדיוק כתוב במסמך, ומה זה אומר עליכם.',
  },
  {
    q: 'קיבלתי חוזה וביקשו שאחתום מהר. אפשר לשלוח לבדיקה?',
    a: 'כן, וזה הזמן הנכון. לפני החתימה עדיין יש כוח מיקוח ואפשר לבקש שינויים; אחרי החתימה, סעיף בעייתי הוא כבר עובדה. לחץ לחתום מהר הוא בדרך כלל סיבה טובה יותר לבדוק, לא פחות.',
  },
  {
    q: 'אני לא בטוח שזה התחום שלכם. שווה לפנות?',
    a: 'שווה. אם הנושא אינו בתחומי העיסוק של המשרד אומר זאת מיד ואפנה אתכם למי שכן מטפל בו. זה חוסך לכם זמן, וזו גם הדרך הנכונה לעבוד.',
  },
  {
    q: 'מה קורה בפנייה הראשונה?',
    a: 'מדברים על מה שצריך: מה המסמך, מי הצד השני, ומה חשוב לכם שיקרה. בסוף השיחה תדעו מה האפשרויות ומה השלב הבא — גם אם המסקנה היא שאין צורך בעורך דין.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/** The six with the most search intent behind them. */
const FEATURED = [
  'lease-agreement',
  'will',
  'demand-letter',
  'contract-review',
  'apartment-purchase',
  'company-registration',
];
const featured = FEATURED.map((slug) => SERVICES.find((s) => s.slug === slug)).filter(
  (s): s is NonNullable<typeof s> => Boolean(s)
);
---
<Base
  title="עו״ד יהונתן שמם | משפט בגובה העיניים, תל אביב"
  description="משרד עורכי דין בתל אביב לעסקים ולאנשים פרטיים: חוזים, צוואות וירושה, נדל״ן ושכירות, הקמת חברות ומכתבי התראה. הסבר בשפה ברורה על מה שאתם חותמים עליו."
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">משרד בוטיק · תל אביב</p>
      <h1>משפט <strong>בגובה העיניים</strong></h1>
      <p class="sub">
        חוזים, צוואות, נדל״ן וליווי עסקי — לעסקים ולאנשים פרטיים. בלי ז׳רגון,
        בלי לקבור את העיקר בהערת שוליים, ועם הסבר ברור על מה שאתם חותמים עליו.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={whatsappLink('שלום, הגעתי מהאתר ורציתי לשאול לגבי')}>כתבו לי בוואטסאפ</a>
        <a class="btn btn-ghost" href={FIRM.calendar}>תיאום פגישה ביומן</a>
      </div>
    </div>
  </section>

  <section class="section" id="featured">
    <div class="wrap">
      <div class="section-head">
        <h2>הנושאים שהכי שואלים עליהם</h2>
        <p>
          לכל נושא עמוד שמסביר מה המסמך מסדיר, מה קורה בלעדיו, ומה כדאי לשים לב
          אליו — גם אם בסוף תחליטו לא לפנות.
        </p>
      </div>
      <div class="cards">
        {featured.map((s) => <ServiceCard service={s} />)}
      </div>
      <a class="all-link" href="/practice-areas/">
        לכל תחומי העיסוק
        <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </section>

  <section class="diff">
    <div class="wrap">
      <q>רוב האנשים לא חותמים על מה שהם לא מבינים. הם חותמים על מה שלא הוסבר להם.</q>
      <p class="diff-note">
        העבודה מתחילה בהסבר: מה המסמך עושה, מה הוא לא עושה, ואיפה הסיכון האמיתי.
        אחרי זה קל יותר להחליט.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <Graphic name="divider-rule" class="divider" />
      <div class="section-head"><h2>מה מביא אתכם לכאן?</h2></div>
      <div class="forks">
        <a class="fork" href="/practice-areas/#estate">
          <Graphic name="cat-property" class="fork-art" />
          <h3>עניין אישי</h3>
          <p>צוואה, ירושה, חוזה שכירות, עסקת דירה, או חוזה שקיבלתם וצריך לקרוא לפני שחותמים.</p>
          <span class="go">לנושאים האישיים <svg class="chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
        <a class="fork" href="/practice-areas/#business">
          <Graphic name="cat-business" class="fork-art" />
          <h3>עסק, חברה או מיזם</h3>
          <p>הקמת חברה, הסכם בין שותפים, התקשרויות מול ספקים ולקוחות, ותקנוני אתר ופרטיות.</p>
          <span class="go">לנושאים העסקיים <svg class="chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <div class="section-head"><h2>שאלות נפוצות</h2></div>
      <Faq items={faqs} />
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: var(--s9) var(--s8); }
  h1 {
    font-size: var(--fs-display);
    font-weight: 300;
    line-height: var(--lh-tight);
    letter-spacing: -0.015em;
    margin-block-start: var(--s5);
  }
  h1 strong { font-weight: 700; }
  .sub { font-size: var(--fs-lead); color: var(--muted); max-width: 52ch; margin-block-start: var(--s5); }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--s3); margin-block-start: var(--s7); }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s4); }
  .all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    margin-block-start: var(--s6);
    color: var(--accent);
    font-weight: 600;
    font-size: var(--fs-small);
    text-decoration: none;
    padding-block: 6px;
  }
  .all-link:hover { text-decoration: underline; }

  .diff { background: var(--ink); color: #fff; }
  .diff :global(.wrap) { padding-block: var(--s9); }
  .diff q {
    display: block;
    quotes: none;
    font-size: clamp(23px, 3.2vw, 38px);
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 26ch;
  }
  /* #b9beba on #1b1d1f measures 8.9:1 */
  .diff-note { color: #b9beba; margin-block-start: var(--s5); max-width: 50ch; font-size: var(--fs-small); }

  .divider { width: 240px; color: var(--line-control); margin-block-end: var(--s6); }

  .forks { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4); }
  .fork {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    padding: var(--s6);
    text-decoration: none;
  }
  .fork:hover { border-color: var(--accent); }
  .fork-art { width: 56px; height: 56px; color: var(--accent); margin-block-end: var(--s4); }
  .fork h3 { font-size: var(--fs-title); font-weight: 600; }
  .fork p { color: var(--muted); font-size: var(--fs-small); margin-block-start: var(--s3); }
  .fork .go {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    color: var(--accent);
    font-weight: 600;
    font-size: var(--fs-small);
    margin-block-start: var(--s5);
  }

  @media (max-width: 1000px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) {
    .cards { grid-template-columns: 1fr; }
    .forks { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .hero { padding-block: var(--s8) var(--s7); }
    .cta-row { flex-direction: column; align-items: stretch; }
  }
</style>
