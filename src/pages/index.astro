---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { Picture } from 'astro:assets';
import portrait from '../assets/yonatan-portrait.jpg';
import { FIRM, whatsappLink } from '../data/firm.ts';
import { SERVICES, CATEGORIES, byCategory, type Category } from '../data/services.ts';

/*
 * Redesigned 27 Jul 2026, after the founder called the previous version generic
 * and boring. He was right, and the diagnosis matters more than the fix: the
 * page was a grid of white cards with shadows, which is the most-repeated
 * container on the web, and the type scale was so narrow that nothing on the
 * page had rank.
 *
 * The treatment now is editorial. The real asset here is sixteen pages of long
 * Hebrew explanation, so the site is set like a publication rather than a
 * service brochure: hairline rules instead of card borders, a numbered index
 * instead of a grid, a display size that actually uses the 200-800 weight range
 * Hebrew leaves as almost its only hierarchy tool, and the mark given enough
 * room to read as a mark.
 */

const faqs = [
  {
    q: 'מתי בכלל צריך עורך דין, ומתי אפשר להסתדר לבד?',
    a: 'ככלל, כשיש מסמך שמחייב אתכם לאורך זמן, כשהסכום משמעותי ביחס אליכם, או כשהצד השני הוא מי שניסח את המסמך. חוזה שכירות, צוואה, עסקת דירה והסכם בין שותפים נכנסים לקטגוריה הזו כמעט תמיד. יש גם דברים שאפשר באמת לעשות לבד, ואם זה המצב אומר לכם את זה.',
  },
  {
    q: 'אתם עובדים גם עם אנשים פרטיים, או רק עם עסקים?',
    a: 'שניהם. חלק מהעבודה היא ליווי חברות ומיזמים, וחלק גדול הוא אנשים פרטיים: צוואות, ירושות, חוזי שכירות ועסקאות דירה. אלה קהלים שונים, אבל השאלה זהה — מה בדיוק כתוב במסמך, ומה זה אומר עליכם.',
  },
  {
    q: 'קיבלתי חוזה וביקשו שאחתום מהר. אפשר לשלוח לבדיקה?',
    a: 'כן, וזה הזמן הנכון. לפני החתימה עדיין יש כוח מיקוח ואפשר לבקש שינויים; אחרי החתימה, סעיף בעייתי הוא כבר עובדה. לחץ לחתום מהר הוא בדרך כלל סיבה טובה יותר לבדוק, לא פחות.',
  },
  {
    q: 'אני לא בטוח שזה התחום שלכם. שווה לפנות?',
    a: 'שווה. אם הנושא אינו בתחומי העיסוק של המשרד אומר זאת מיד ואפנה אתכם למי שכן מטפל בו. זה חוסך לכם זמן, וזו גם הדרך הנכונה לעבוד.',
  },
  {
    q: 'מה קורה בפנייה הראשונה?',
    a: 'מדברים על מה שצריך: מה המסמך, מי הצד השני, ומה חשוב לכם שיקרה. בסוף השיחה תדעו מה האפשרויות ומה השלב הבא — גם אם המסקנה היא שאין צורך בעורך דין.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const ORDER: Category[] = ['contracts', 'estate', 'property', 'business', 'enforcement'];
let running = 0;
const groups = ORDER.map((key) => {
  const items = byCategory(key);
  const group = { key, items, offset: running };
  running += items.length;
  return group;
});
---
<Base
  title="עו״ד יהונתן שמם | משפט בגובה העיניים, תל אביב"
  description="משרד עורכי דין בתל אביב לעסקים ולאנשים פרטיים: חוזים, צוואות וירושה, נדל״ן ושכירות, הקמת חברות ומכתבי התראה. הסבר בשפה ברורה על מה שאתם חותמים עליו."
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="eyebrow">משרד עורכי דין · תל אביב</p>
        <h1>משפט<br /><strong>בגובה העיניים</strong></h1>
        <p class="sub">
          חוזים, צוואות, נדל״ן וליווי עסקי — לעסקים ולאנשים פרטיים.
          בלי ז׳רגון, ועם הסבר ברור על מה שאתם חותמים עליו.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={whatsappLink('שלום, הגעתי מהאתר ורציתי לשאול לגבי')}>כתבו לי בוואטסאפ</a>
          <a class="btn btn-ghost" href={FIRM.calendar}>תיאום פגישה ביומן</a>
        </div>
      </div>
      {/* The mark, at a size where it reads as a mark. Decorative: the firm is
          named in the header and in the h1 beside it. */}
      <img class="hero-mark" src="/logo-shield-display.png" width="342" height="440" alt="" decoding="async" />
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <div class="spread">
        <div class="rail-label">
          <span class="numeral">01</span>
          תחומי עיסוק
        </div>
        <div>
          <h2 class="section-title">השירותים שלנו</h2>
          <p class="section-lead">
            המשרד מטפל בחוזים והסכמים, בצוואות וירושה, בעסקאות נדל״ן ובליווי
            שוטף של חברות ועסקים. לכל נושא עמוד ייעודי עם הסבר מפורט.
          </p>

          {/* Five compact groups, not sixteen equal rows. The full index
              lives on /practice-areas/ — showing everything here read as a
              grocery list, which is exactly what it was. */}
          <div class="groups">
            {groups.map(({ key, items }) => (
              <section class="group">
                <h3>{CATEGORIES[key].title}</h3>
                <p class="blurb">{CATEGORIES[key].blurb}</p>
                <ul class="topics">
                  {items.map((s) => (
                    <li><a href={`/practice-areas/${s.slug}/`}>{s.shortTitle ?? s.title}</a></li>
                  ))}
                </ul>
              </section>
            ))}
          </div>

          <a class="all-link" href="/practice-areas/">
            כל תחומי העיסוק, עם הסבר על כל אחד
            <svg class="chev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="firm">
    <div class="wrap spread">
      <div class="rail-label"><span class="numeral">02</span>המשרד</div>
      <div class="firm-in">
        {/* A 160px circle, not a 230px rectangle. The photograph is soft at
            native resolution and no pipeline setting fixes that, so the display
            was cut down and cropped to head-and-shoulders: every delivered
            pixel is now face rather than suit and window, which raises apparent
            sharpness at the same file size. The square master comes from
            scripts/build-portrait.py. */}
        <Picture
          class="portrait"
          src={portrait}
          formats={['avif', 'webp']}
          quality={70}
          widths={[120, 160, 240, 320]}
          sizes="(max-width: 760px) 120px, 160px"
          alt="עו״ד יהונתן שמם"
          loading="lazy"
          decoding="async"
        />
        <div class="firm-copy">
          <h2>עו״ד יהונתן שמם</h2>
          <p>
            הוסמך כעורך דין בשנת <bdi dir="ltr">2019</bdi>. את שנותיו הראשונות
            במקצוע עשה כעורך דין במשרד גולדפרב זליגמן, ולפני כן התמחה במשרד
            ש. הררי בתחומי הנדל״ן ודיני החברות.
          </p>
          <p>
            המשרד מלווה עסקים ואנשים פרטיים בתל אביב ובמרכז, בעברית ובאנגלית.
          </p>
          <a class="firm-link" href="/about/">
            אודות המשרד
            <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="spread">
        <div class="rail-label">
          <span class="numeral">03</span>
          למי זה מיועד
        </div>
        <div class="forks">
          <a class="fork" href="/practice-areas/#estate">
            <Icon name="scroll" size={24} class="fork-ico" />
            <h3>עניין אישי</h3>
            <p>צוואה, ירושה, חוזה שכירות, עסקת דירה, או חוזה שקיבלתם וצריך לקרוא לפני שחותמים.</p>
            <span class="go">לנושאים האישיים <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
          <a class="fork" href="/practice-areas/#business">
            <Icon name="buildings" size={24} class="fork-ico" />
            <h3>עסק, חברה או מיזם</h3>
            <p>הקמת חברה, הסכם בין שותפים, התקשרויות מול ספקים ולקוחות, ותקנוני אתר ופרטיות.</p>
            <span class="go">לנושאים העסקיים <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <div class="spread">
        <div class="rail-label">
          <span class="numeral">04</span>
          שאלות נפוצות
        </div>
        <Faq items={faqs} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: clamp(48px, 8vw, 112px) var(--s9); }
  .hero-in { display: flex; align-items: center; gap: var(--s8); }
  .hero-copy { flex: 1; min-width: 0; }

  h1 {
    font-size: var(--fs-display);
    font-weight: 200;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-block-start: var(--s5);
  }
  h1 strong { font-weight: 700; }
  .sub {
    font-size: var(--fs-lead);
    color: var(--muted);
    max-width: 44ch;
    margin-block-start: var(--s6);
    line-height: 1.6;
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--s3); margin-block-start: var(--s7); }

  .hero-mark {
    flex: none;
    width: clamp(120px, 16vw, 210px);
    height: auto;
    /* The gold is the logo's alone and is never borrowed for anything else.
       Held back so it sits behind the type rather than competing with it. */
    opacity: .9;
  }

  /* ---------- sections ---------- */
  .section-title {
    font-size: var(--fs-section);
    font-weight: 200;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .section-lead {
    color: var(--muted);
    max-width: 56ch;
    margin-block: var(--s4) var(--s8);
    font-size: var(--fs-lead);
    line-height: 1.6;
  }

  .groups { display: grid; gap: 0; }
  .group { padding-block: var(--s5); border-block-start: 1px solid var(--rule); }
  .group:first-child { border-block-start: 1px solid var(--ink); }
  .group h3 { font-size: var(--fs-title); font-weight: 500; letter-spacing: -0.015em; }
  .blurb { color: var(--muted); font-size: var(--fs-small); margin-block-start: var(--s2); max-width: 60ch; }

  /* Topic names as inline links. Compact enough that five categories read as
     a table of contents rather than a menu of sixteen things to buy. */
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) 0;
    margin-block-start: var(--s4);
  }
  .topics li { display: flex; align-items: center; }
  .topics li + li::before {
    content: '';
    width: 1px;
    height: 12px;
    background: var(--rule);
    margin-inline: var(--s3);
  }
  .topics a {
    font-size: var(--fs-small);
    text-decoration: none;
    color: var(--ink);
    padding-block: 4px;
  }
  .topics a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  /* ---------- differentiator ---------- */
  .firm { background: var(--ink); color: #fff; }
  .firm :global(.wrap) { padding-block: var(--s9); }
  .firm :global(.rail-label) { color: #8d938f; }
  .firm :global(.numeral) { color: #666d68; }  /* 3.18:1 on the ink band */
  .firm-in { display: flex; gap: var(--s7); align-items: center; }
  /* <Picture> wraps the <img>, so the <picture> is the flex item and the
     sizing belongs here. Do NOT use display:contents to promote the <img>
     instead — flex and grid blockify their items, so the two <source> elements
     inside <picture> become real flex items as well. On the about page that
     took two grid tracks and pushed the content onto a second row. */
  .firm-in > picture { flex: none; width: 160px; }
  .portrait {
    display: block;
    width: 100%;
    height: auto;
    /* The master is square, so 50% is a true circle and nothing is squashed. */
    border-radius: 50%;
  }
  .firm-copy h2 { font-size: var(--fs-section); font-weight: 200; letter-spacing: -0.025em; }
  /* #c3c8c5 on #1b1d1f measures 10.1:1 */
  .firm-copy p { color: #c3c8c5; margin-block-start: var(--s4); max-width: 48ch; }
  .firm-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    margin-block-start: var(--s5);
    color: #fff;
    font-weight: 600;
    font-size: var(--fs-small);
    text-decoration: none;
    padding-block: 6px;
    border-block-end: 1px solid rgba(255, 255, 255, .4);
  }
  .firm-link:hover { border-block-end-color: #fff; }



  .divider { width: 240px; color: var(--line-control); margin-block-end: var(--s6); }

  .all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    margin-block-start: var(--s7);
    color: var(--accent);
    font-weight: 600;
    font-size: var(--fs-small);
    text-decoration: none;
    padding-block: 6px;
  }
  .all-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .forks { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .fork {
    padding: var(--s6) var(--s6) var(--s6) 0;
    text-decoration: none;
    border-block-start: 1px solid var(--ink);
  }
  .fork + .fork {
    border-inline-start: 1px solid var(--rule);
    padding-inline-start: var(--s6);
    padding-inline-end: 0;
  }
  .fork-ico { color: var(--accent); margin-block-end: var(--s4); }
  .fork h3 { font-size: var(--fs-title); font-weight: 500; letter-spacing: -0.015em; margin-block-start: var(--s4); }
  .fork p { color: var(--muted); font-size: var(--fs-small); margin-block-start: var(--s3); }
  .fork:hover h3 { color: var(--accent); }
  .fork .go {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    color: var(--accent);
    font-weight: 600;
    font-size: var(--fs-small);
    margin-block-start: var(--s5);
  }

  @media (max-width: 860px) {
    .hero-in { flex-direction: column-reverse; align-items: flex-start; gap: var(--s6); }
    .hero-mark { width: 96px; }
  }
  @media (max-width: 760px) {
    .firm-in { flex-direction: column; align-items: flex-start; gap: var(--s5); }
    .firm-in > picture { width: 120px; }
    .forks { grid-template-columns: 1fr; }
    .fork { padding-inline: 0; }
    .fork + .fork { border-inline-start: 0; padding-inline-start: 0; }
  }
  @media (max-width: 700px) {
    .cta-row { flex-direction: column; align-items: stretch; }
  }
</style>
