---
import Base from '../layouts/Base.astro';
import { FIRM, whatsappLink } from '../data/firm.ts';
import Icon from '../components/Icon.astro';

/*
 * No contact form yet, on purpose.
 *
 * Under Amendment 13, a database holding ONLY name, address and contact
 * details for up to 100,000 people is not a "database" and sits outside the
 * whole regime. Add one "tell me what this is about" field and that relief
 * disappears — and because lawyer-client confidentiality is a statutory duty,
 * enquiry data is arguably information of special sensitivity, which doubles
 * the exposure.
 *
 * That is a decision for the founder, not a default to pick silently. Until he
 * makes it, this page ships the routes the Israeli market actually uses and
 * that the live site already relies on: WhatsApp, calendar, phone, email.
 *
 * When the form is built, whichever variant is chosen, the §11 notice has to
 * sit next to the submit button — not behind a link to the privacy policy.
 */

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  mainEntity: { '@id': `${Astro.site}#attorney` },
};
---
<Base
  title="צור קשר — עו״ד יהונתן שמם | משרד עורכי דין בתל אביב"
  description={`יצירת קשר עם משרד עו״ד יהונתן שמם: וואטסאפ, טלפון ${FIRM.phone.display}, תיאום פגישה ביומן. ${FIRM.address.full}.`}
  schema={schema}
>
  <div class="wrap lede">
    <p class="eyebrow">צור קשר</p>
    <h1>הדרך המהירה היא וואטסאפ</h1>
    <p class="sub">
      כתבו משפט אחד על מה שאתם צריכים. אם זה מתאים למשרד — נמשיך משם; ואם לא,
      אפנה אתכם הלאה.
    </p>
  </div>

  <div class="wrap body">
    <section class="spread">
      <div class="rail-label"><span class="numeral">01</span>איך לפנות</div>
      <ul class="routes">
        <li>
          <a href={whatsappLink('שלום, הגעתי מהאתר ורציתי לשאול לגבי')}>
            <Icon name="whatsapp-logo" size={20} class="route-ico" />
            <div><b>וואטסאפ</b><span>ההודעה נפתחת מוכנה. מספיק להשלים במה מדובר.</span></div>
            <svg class="chev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </li>
        <li>
          <a href={FIRM.calendar}>
            <Icon name="calendar-blank" size={20} class="route-ico" />
            <div><b>פגישה ביומן</b><span>בחירת מועד ישירות ביומן המשרד, בלי תיאום הלוך ושוב.</span></div>
            <svg class="chev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </li>
        <li>
          <a href={`tel:${FIRM.phone.tel}`}>
            <Icon name="phone" size={20} class="route-ico" />
            <div><b>טלפון</b><span><bdi dir="ltr">{FIRM.phone.display}</bdi></span></div>
            <svg class="chev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </li>
        <li>
          <a href={`mailto:${FIRM.email}`}>
            <Icon name="envelope-simple" size={20} class="route-ico" />
            <div><b>דוא״ל</b><span><bdi dir="ltr">{FIRM.email}</bdi></span></div>
            <svg class="chev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </li>
      </ul>
    </section>

    <section class="spread">
      <div class="rail-label"><span class="numeral">02</span>המשרד</div>
      <dl class="facts">
        <dt>כתובת</dt>
        <dd>{FIRM.address.building}, {FIRM.address.street}, {FIRM.address.city}</dd>
        <dt>שעות פעילות</dt>
        <dd>{FIRM.hours.days}, <bdi dir="ltr">{FIRM.hours.open}–{FIRM.hours.close}</bdi></dd>
        <dt>רכז נגישות</dt>
        <dd>{FIRM.accessibilityCoordinator.name} · <a href="/terms-privacy-accessibility/#accessibility">להצהרת הנגישות</a></dd>
      </dl>
    </section>
  </div>

  <div class="wrap">
    <p class="disclaimer">
      פנייה דרך אחד הערוצים האלה אינה יוצרת יחסי עורך־דין לקוח. יחסים אלה
      נוצרים רק לאחר התקשרות פורמלית וחתימה על הסכם בכתב.
    </p>
  </div>
</Base>

<style>
  .lede { padding-block: var(--s8); border-block-end: 1px solid var(--ink); }
  h1 {
    font-size: clamp(38px, 6.6vw, 78px);
    font-weight: 200;
    letter-spacing: -0.03em;
    line-height: 1.04;
    margin-block-start: var(--s4);
    max-width: 16ch;
  }
  .sub { font-size: var(--fs-lead); color: var(--muted); max-width: 48ch; margin-block-start: var(--s5); line-height: 1.6; }

  .body { padding-block: var(--s8); }
  .body > .spread { padding-block-end: var(--s8); }
  .body > .spread + .spread { border-block-start: 1px solid var(--rule); padding-block-start: var(--s8); }

  /* Ruled rows rather than a grid of cards — the same treatment as the
     service index, so the site reads as one thing. */
  .routes { border-block-start: 1px solid var(--ink); max-width: var(--measure); }
  .routes li { border-block-end: 1px solid var(--rule); }
  .routes a {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s4);
    padding-block: var(--s5);
    text-decoration: none;
    transition: background-color .16s;
  }
  .routes a:hover { background: var(--surface); }
  .route-ico { color: var(--muted); }
  .routes a:hover .route-ico { color: var(--accent); }
  .routes b { font-size: var(--fs-title); font-weight: 500; letter-spacing: -0.015em; }
  .routes a:hover b { color: var(--accent); }
  .routes span { display: block; font-size: var(--fs-small); color: var(--muted); margin-block-start: var(--s1); }
  .routes .chev { color: var(--line-control); }
  .routes a:hover .chev { color: var(--accent); }

  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 0 var(--s5); font-size: var(--fs-small); max-width: var(--measure); }
  .facts dt { color: var(--muted); padding-block: var(--s3); border-block-start: 1px solid var(--rule); }
  .facts dd { margin: 0; padding-block: var(--s3); border-block-start: 1px solid var(--rule); font-weight: 500; }
  .facts a { color: var(--accent); display: inline-block; padding-block: 4px; }

  .disclaimer {
    color: var(--faint);
    font-size: var(--fs-caption);
    max-width: 78ch;
    padding-block: var(--s5) var(--s9);
    border-block-start: 1px solid var(--rule);
  }

  @media (max-width: 600px) {
    .facts { grid-template-columns: 1fr; gap: 0; }
    .facts dt { border-block-start: 1px solid var(--rule); padding-block-end: 0; }
    .facts dd { border-block-start: 0; padding-block-start: var(--s1); }
  }
</style>
