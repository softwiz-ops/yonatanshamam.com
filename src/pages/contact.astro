---
import Base from '../layouts/Base.astro';
import { FIRM, whatsappLink } from '../data/firm.ts';

/*
 * No contact form yet, on purpose.
 *
 * Under Amendment 13, a database holding ONLY name, address and contact
 * details for up to 100,000 people is not a "database" and sits outside the
 * whole regime. Add one "tell me what this is about" field and that relief
 * disappears — and because lawyer-client confidentiality is a statutory duty,
 * enquiry data is arguably information of special sensitivity, which doubles
 * the exposure.
 *
 * That is a decision for the founder, not a default to pick silently. Until he
 * makes it, this page ships the routes the Israeli market actually uses and
 * that the live site already relies on: WhatsApp, calendar, phone, email.
 *
 * When the form is built, whichever variant is chosen, the §11 notice has to
 * sit next to the submit button — not behind a link to the privacy policy.
 */

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  mainEntity: { '@id': `${Astro.site}#attorney` },
};
---
<Base
  title="צור קשר | עו״ד יהונתן שמם"
  description={`יצירת קשר עם משרד עו״ד יהונתן שמם: וואטסאפ, טלפון ${FIRM.phone.display}, תיאום פגישה ביומן. ${FIRM.address.full}.`}
  schema={schema}
>
  <div class="wrap lede">
    <p class="eyebrow">צור קשר</p>
    <h1>הדרך המהירה היא וואטסאפ</h1>
    <p class="sub">
      כתבו משפט אחד על מה שאתם צריכים. אם זה מתאים למשרד — נמשיך משם; ואם לא,
      אפנה אתכם הלאה.
    </p>
  </div>

  <div class="wrap routes">
    <a class="route route-primary" href={whatsappLink('הגעתי מהאתר ואני מתעניין ב-')}>
      <h2>וואטסאפ</h2>
      <p>ההודעה נפתחת מוכנה. מספיק להשלים במה מדובר.</p>
      <span class="go">פתיחת שיחה <svg class="chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </a>

    <a class="route" href={FIRM.calendar}>
      <h2>פגישה ביומן</h2>
      <p>בחירת מועד ישירות ביומן המשרד, בלי תיאום הלוך ושוב.</p>
      <span class="go">בחירת מועד <svg class="chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </a>

    <a class="route" href={`tel:${FIRM.phone.tel}`}>
      <h2>טלפון</h2>
      <p><bdi dir="ltr">{FIRM.phone.display}</bdi></p>
      <span class="go">חיוג <svg class="chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </a>

    <a class="route" href={`mailto:${FIRM.email}`}>
      <h2>דוא״ל</h2>
      <p><bdi dir="ltr">{FIRM.email}</bdi></p>
      <span class="go">שליחת הודעה <svg class="chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </a>
  </div>

  <div class="wrap details">
    <section>
      <h2>המשרד</h2>
      <p class="addr">{FIRM.address.building}<br />{FIRM.address.street}<br />{FIRM.address.city}</p>
    </section>
    <section>
      <h2>שעות פעילות</h2>
      <p>{FIRM.hours.days}<br /><bdi dir="ltr">{FIRM.hours.open}–{FIRM.hours.close}</bdi></p>
    </section>
    <section>
      <h2>נגישות</h2>
      <p>
        רכז נגישות: {FIRM.accessibilityCoordinator.name}<br />
        זמן מענה: {FIRM.accessibilityCoordinator.responseTime}<br />
        <a href="/terms-privacy-accessibility/#accessibility">להצהרת הנגישות</a>
      </p>
    </section>
  </div>

  <div class="wrap">
    <p class="disclaimer">
      פנייה דרך אחד הערוצים האלה אינה יוצרת יחסי עורך־דין לקוח. יחסים אלה
      נוצרים רק לאחר התקשרות פורמלית וחתימה על הסכם בכתב.
    </p>
  </div>
</Base>

<style>
  .lede { padding-block: var(--s7) var(--s6); }
  h1 {
    font-size: clamp(30px, 4.4vw, 48px);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: var(--lh-tight);
    margin-block-start: var(--s4);
    max-width: 18ch;
  }
  .sub { font-size: var(--fs-lead); color: var(--muted); max-width: 50ch; margin-block-start: var(--s5); }

  .routes { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s4); padding-block-end: var(--s7); }
  .route {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    padding: var(--s6);
    text-decoration: none;
    transition: border-color .15s, box-shadow .15s;
  }
  .route:hover { border-color: var(--accent); box-shadow: var(--shadow-card); }
  .route-primary { border-color: color-mix(in srgb, var(--accent) 35%, transparent); background: var(--accent-wash); }
  .route h2 { font-size: var(--fs-title); font-weight: 600; }
  .route p { color: var(--muted); font-size: var(--fs-small); margin-block-start: var(--s3); }
  .route .go {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    color: var(--accent);
    font-weight: 600;
    font-size: var(--fs-small);
    margin-block-start: var(--s5);
  }

  .details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s6);
    padding-block: var(--s7);
    border-block-start: 1px solid var(--rule);
  }
  .details h2 { font-size: var(--fs-caption); color: var(--muted); font-weight: 600; margin-block-end: var(--s3); }
  .details p { font-size: var(--fs-small); }
  .details a { color: var(--accent); display: inline-block; padding-block: 3px; }

  .disclaimer {
    color: var(--faint);
    font-size: var(--fs-caption);
    max-width: 78ch;
    padding-block: var(--s5) var(--s9);
  }

  @media (max-width: 820px) {
    .routes { grid-template-columns: 1fr; }
    .details { grid-template-columns: 1fr; gap: var(--s5); }
  }
</style>
