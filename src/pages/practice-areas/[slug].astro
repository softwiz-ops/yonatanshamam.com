---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import { FIRM, whatsappLink } from '../../data/firm.ts';
import { SERVICES, CATEGORIES, byCategory } from '../../data/services.ts';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const category = CATEGORIES[service.category];
const related = byCategory(service.category).filter((s) => s.slug !== service.slug).slice(0, 3);

const waMessage = `שלום, הגעתי מהאתר בנוגע ל${service.title}`;
const primaryHref =
  service.primaryCta.type === 'calendar' ? FIRM.calendar : whatsappLink(waMessage);

const AUDIENCE = { private: 'אנשים פרטיים', business: 'עסקים וחברות', both: 'עסקים ואנשים פרטיים' };

/*
 * Service + FAQPage + BreadcrumbList. No `offers`, no priceRange, no
 * aggregateRating: the first two are barred by the Bar's rules on fees, which
 * apply to structured data exactly as to visible copy, and the third would be a
 * testimonial claim the founder ruled out. No turnaround anywhere, deliberately.
 */
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: service.title,
      description: service.seoDescription,
      serviceType: category.title,
      provider: { '@id': `${Astro.site}#attorney` },
      areaServed: { '@type': 'Country', name: 'IL' },
      audience: { '@type': 'Audience', audienceType: AUDIENCE[service.audience] },
      availableLanguage: FIRM.languages,
    },
    {
      '@type': 'FAQPage',
      mainEntity: service.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ראשי', item: `${Astro.site}` },
        { '@type': 'ListItem', position: 2, name: 'תחומי עיסוק', item: `${Astro.site}practice-areas/` },
        { '@type': 'ListItem', position: 3, name: service.title },
      ],
    },
  ],
};
---
<Base
  title={service.seoTitle}
  description={service.seoDescription}
  schema={schema}
  waMessage={waMessage}
  waLabel={`שאלה על ${service.shortTitle ?? service.title}`}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="מיקום בעמוד">
      <a href="/">ראשי</a>
      <span class="sep chev" aria-hidden="true">›</span>
      <a href="/practice-areas/">תחומי עיסוק</a>
      <span class="sep chev" aria-hidden="true">›</span>
      <span>{service.shortTitle ?? service.title}</span>
    </nav>
  </div>

  <header class="wrap lede">
    <p class="eyebrow">{category.title}</p>
    <h1>{service.title}</h1>
    <p class="summary">{service.summary}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href={primaryHref}>{service.primaryCta.label}</a>
      <a class="btn btn-ghost" href={FIRM.calendar}>תיאום פגישה ביומן</a>
    </div>
  </header>

  <div class="wrap body">
    <section class="spread">
      <div class="rail-label"><span class="numeral">01</span>מה חשוב לדעת</div>
      <div class="prose">{service.intro.map((p) => <p>{p}</p>)}</div>
    </section>

    <section class="spread">
      <div class="rail-label"><span class="numeral">02</span>מה המסמך מסדיר</div>
      {/* "What the instrument regulates" — general legal knowledge. Not "what
          the service includes", which would be a commitment by the firm. */}
      <ul class="covers">
        {service.covers.map((c) => (
          <li>
            <b>{c.title}</b>
            <span>{c.detail}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="spread">
      <div class="rail-label"><span class="numeral">03</span>למה זה משנה</div>
      <p class="matters">{service.whyItMatters}</p>
    </section>

    <section class="spread">
      <div class="rail-label"><span class="numeral">04</span>מה כדאי לשים לב אליו</div>
      {/* The section people actually read, and the one a generative engine is
          most likely to quote. Concrete mistakes, not reassurance. */}
      <ul class="watch">
        {service.watchFor.map((w) => (
          <li>
            <Icon name="warning-circle" size={17} class="watch-ico" />
            <div><b>{w.title}</b><span>{w.detail}</span></div>
          </li>
        ))}
      </ul>
    </section>

    <section class="spread">
      <div class="rail-label"><span class="numeral">05</span>שאלות נפוצות</div>
      <Faq items={service.faqs} />
    </section>

    {related.length > 0 && (
      <section class="spread">
        <div class="rail-label"><span class="numeral">06</span>נושאים קרובים</div>
        <ul class="related">
          {related.map((r) => (
            <li>
              <a href={`/practice-areas/${r.slug}/`}>
                <b>{r.shortTitle ?? r.title}</b>
                <span>{r.summary}</span>
                <svg class="chev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <aside class="closing">
    <div class="wrap spread">
      <div class="rail-label"><span class="numeral">07</span></div>
      <div>
        <h2>יש שאלה על {service.shortTitle ?? service.title}?</h2>
        <p>
          כתבו במשפט אחד מה העניין. אם זה מתאים למשרד נמשיך משם, ואם לא —
          אפנה אתכם הלאה.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={whatsappLink(waMessage)}>כתיבה בוואטסאפ</a>
          <a class="btn btn-ghost" href={FIRM.calendar}>תיאום פגישה ביומן</a>
        </div>
        <p class="closing-meta">
          <bdi><a href={`tel:${FIRM.phone.tel}`} dir="ltr">{FIRM.phone.display}</a></bdi>
          <span class="dot">·</span>
          {FIRM.hours.days} <bdi dir="ltr">{FIRM.hours.open}–{FIRM.hours.close}</bdi>
        </p>
      </div>
    </div>
  </aside>
</Base>

<style>
  .crumbs { font-size: var(--fs-caption); color: var(--muted); padding-block: var(--s5); }
  .crumbs a { text-decoration: none; display: inline-block; padding-block: 4px; }
  .crumbs a:hover { text-decoration: underline; }
  .sep { display: inline-block; margin-inline: var(--s2); }

  .lede { padding-block-end: var(--s8); border-block-end: 1px solid var(--ink); }
  h1 {
    font-size: clamp(38px, 6.4vw, 76px);
    font-weight: 200;
    letter-spacing: -0.03em;
    line-height: 1.04;
    margin-block-start: var(--s4);
    max-width: 16ch;
  }
  .summary {
    font-size: var(--fs-lead);
    color: var(--muted);
    max-width: 52ch;
    margin-block-start: var(--s6);
    line-height: 1.6;
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--s3); margin-block-start: var(--s6); }

  .body { padding-block: var(--s8) var(--s9); }
  .body > .spread { padding-block-end: var(--s8); }
  .body > .spread + .spread { border-block-start: 1px solid var(--rule); padding-block-start: var(--s8); }

  .prose { max-width: var(--measure); }
  .prose p + p { margin-block-start: var(--s5); }

  /* Ruled rows, not cards. */
  .covers li {
    padding-block: var(--s4);
    border-block-end: 1px solid var(--rule);
    max-width: var(--measure);
  }
  .covers li:first-child { border-block-start: 1px solid var(--rule); }
  .covers b { font-weight: 600; }
  .covers span { display: block; color: var(--muted); font-size: var(--fs-small); margin-block-start: var(--s1); }

  .matters {
    font-size: var(--fs-title);
    font-weight: 300;
    line-height: 1.45;
    letter-spacing: -0.01em;
    max-width: 46ch;
    padding-inline-start: var(--s5);
    border-inline-start: 2px solid var(--accent);
  }

  .watch { display: grid; gap: var(--s5); max-width: var(--measure); }
  .watch li { display: flex; gap: var(--s4); align-items: flex-start; }
  .watch-ico { color: var(--accent); margin-block-start: 3px; }
  .watch b { display: block; font-weight: 600; }
  .watch span { display: block; color: var(--muted); font-size: var(--fs-small); margin-block-start: var(--s1); }

  .related { border-block-start: 1px solid var(--rule); max-width: var(--measure); }
  .related li { border-block-end: 1px solid var(--rule); }
  .related a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s4);
    padding-block: var(--s4);
    text-decoration: none;
  }
  .related b { font-weight: 500; font-size: var(--fs-body); }
  .related span { display: block; font-size: var(--fs-small); color: var(--muted); margin-block-start: var(--s1); }
  .related a:hover b { color: var(--accent); }
  .related .chev { color: var(--line-control); }
  .related a:hover .chev { color: var(--accent); }

  .closing { background: var(--surface); border-block-start: 1px solid var(--rule); }
  .closing :global(.wrap) { padding-block: var(--s8); }
  .closing h2 { font-size: var(--fs-section); font-weight: 200; letter-spacing: -0.025em; line-height: 1.1; }
  .closing p { color: var(--muted); max-width: 46ch; margin-block-start: var(--s4); }
  .closing-meta { font-size: var(--fs-small); margin-block-start: var(--s5); }
  .closing-meta a { color: var(--accent); display: inline-block; padding-block: 4px; }
  /* --line-control is 3.29:1, which is the floor for a UI border but not for
     15px text. A visible separator is text. */
  .dot { color: var(--muted); margin-inline: var(--s2); }  /* 6.33:1 */

  @media (max-width: 700px) {
    .cta-row { flex-direction: column; align-items: stretch; }
  }
</style>
