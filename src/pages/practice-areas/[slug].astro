---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { FIRM, whatsappLink } from '../../data/firm.ts';
import { SERVICES, CATEGORIES, byCategory } from '../../data/services.ts';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const category = CATEGORIES[service.category];
const related = byCategory(service.category).filter((s) => s.slug !== service.slug).slice(0, 3);

const waMessage = `שלום, הגעתי מהאתר בנוגע ל${service.title}`;
const primaryHref =
  service.primaryCta.type === 'calendar' ? FIRM.calendar : whatsappLink(waMessage);

const AUDIENCE = { private: 'אנשים פרטיים', business: 'עסקים וחברות', both: 'עסקים ואנשים פרטיים' };

/*
 * Service + FAQPage + BreadcrumbList.
 *
 * No `offers`, no priceRange, no aggregateRating. The first two are barred by
 * the Bar's rules on fees, which apply to structured data exactly as they do to
 * visible copy; the third would be a testimonial claim, which the founder ruled
 * out. There is also no turnaround anywhere — that is deliberate, not an
 * omission.
 */
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: service.title,
      description: service.seoDescription,
      serviceType: category.title,
      provider: { '@id': `${Astro.site}#attorney` },
      areaServed: { '@type': 'Country', name: 'IL' },
      audience: { '@type': 'Audience', audienceType: AUDIENCE[service.audience] },
      availableLanguage: FIRM.languages,
    },
    {
      '@type': 'FAQPage',
      mainEntity: service.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ראשי', item: `${Astro.site}` },
        { '@type': 'ListItem', position: 2, name: 'תחומי עיסוק', item: `${Astro.site}practice-areas/` },
        { '@type': 'ListItem', position: 3, name: service.title },
      ],
    },
  ],
};
---
<Base
  title={service.seoTitle}
  description={service.seoDescription}
  schema={schema}
  waMessage={waMessage}
  waLabel={`שאלה על ${service.shortTitle ?? service.title}`}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="מיקום בעמוד">
      <a href="/">ראשי</a>
      <span class="sep chev" aria-hidden="true">›</span>
      <a href="/practice-areas/">תחומי עיסוק</a>
      <span class="sep chev" aria-hidden="true">›</span>
      <span>{service.shortTitle ?? service.title}</span>
    </nav>
  </div>

  <div class="wrap lede">
    <p class="eyebrow">{category.title}</p>
    <h1>{service.title}</h1>
    <p class="summary">{service.summary}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href={primaryHref}>{service.primaryCta.label}</a>
      <a class="btn btn-ghost" href={FIRM.calendar}>תיאום פגישה ביומן</a>
    </div>
  </div>

  <div class="wrap body-grid">
    <div>
      <section class="block">
        <h2>מה חשוב לדעת</h2>
        {service.intro.map((p) => <p>{p}</p>)}
      </section>

      <section class="block">
        <h2>מה המסמך מסדיר</h2>
        {/* "What the instrument regulates" — general legal knowledge. Not
            "what the service includes", which would be a firm commitment. */}
        <ul class="covers">
          {service.covers.map((c) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M4 12l6 6L20 6"/></svg>
              <div><b>{c.title}</b><span>{c.detail}</span></div>
            </li>
          ))}
        </ul>
      </section>

      <section class="block">
        <h2>למה זה משנה</h2>
        <p class="matters">{service.whyItMatters}</p>
      </section>

      <section class="block">
        <h2>מה כדאי לשים לב אליו</h2>
        {/* The section people actually read, and the one a generative engine
            is most likely to quote. Concrete mistakes, not reassurance. */}
        <ul class="watch">
          {service.watchFor.map((w) => (
            <li>
              <b>{w.title}</b>
              <span>{w.detail}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="block">
        <h2>שאלות נפוצות</h2>
        <Faq items={service.faqs} />
      </section>

      {related.length > 0 && (
        <section class="block">
          <h2>נושאים קרובים</h2>
          <div class="related">
            {related.map((r) => (
              <a class="rel" href={`/practice-areas/${r.slug}/`}>
                <b>{r.shortTitle ?? r.title}</b>
                <span>{r.summary}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="aside">
      <div class="panel">
        <h2>יש שאלה?</h2>
        <p class="panel-lead">
          אפשר לכתוב בוואטסאפ ולתאר במשפט אחד מה העניין. אם זה מתאים למשרד נמשיך
          משם, ואם לא — אפנה אתכם הלאה.
        </p>
        <a class="btn btn-primary panel-btn" href={whatsappLink(waMessage)}>כתיבה בוואטסאפ</a>
        <a class="btn btn-ghost panel-btn" href={FIRM.calendar}>תיאום פגישה ביומן</a>
        <ul class="facts">
          <li><span class="k">טלפון</span><span class="v"><bdi><a href={`tel:${FIRM.phone.tel}`} dir="ltr">{FIRM.phone.display}</a></bdi></span></li>
          <li><span class="k">שעות</span><span class="v">{FIRM.hours.days} <bdi dir="ltr">{FIRM.hours.open}–{FIRM.hours.close}</bdi></span></li>
        </ul>
      </div>
    </aside>
  </div>
</Base>

<style>
  .crumbs { font-size: var(--fs-caption); color: var(--muted); padding-block: var(--s5); }
  .crumbs a { text-decoration: none; display: inline-block; padding-block: 4px; }
  .crumbs a:hover { text-decoration: underline; }
  .sep { display: inline-block; margin-inline: var(--s2); }

  .lede { padding-block-end: var(--s7); }
  h1 {
    font-size: clamp(30px, 4.4vw, 48px);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: var(--lh-tight);
    margin-block-start: var(--s4);
    max-width: 18ch;
  }
  .summary { font-size: var(--fs-lead); color: var(--muted); max-width: 54ch; margin-block-start: var(--s5); }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--s3); margin-block-start: var(--s6); }

  .body-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--s8);
    align-items: start;
    padding-block: var(--s7) var(--s9);
  }
  .block { margin-block-end: var(--s8); }
  .block:last-child { margin-block-end: 0; }
  .block > h2 {
    font-size: var(--fs-section);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-block-end: var(--s5);
  }
  .block > p { max-width: var(--measure); }
  .block > p + p { margin-block-start: var(--s4); }
  .matters {
    padding-inline-start: var(--s5);
    border-inline-start: 3px solid var(--accent);
    font-size: var(--fs-lead);
  }

  .covers { display: grid; gap: var(--s3); }
  .covers li {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    padding: var(--s4) var(--s5);
    display: flex;
    gap: var(--s4);
    align-items: flex-start;
  }
  /* A check mark is not directional and must never be mirrored. */
  .covers svg { flex: none; color: var(--accent); margin-block-start: 6px; }
  .covers b { font-weight: 600; }
  .covers span { display: block; color: var(--muted); font-size: var(--fs-small); margin-block-start: 2px; }

  .watch { display: grid; gap: var(--s4); max-width: var(--measure); }
  .watch li {
    padding-inline-start: var(--s5);
    border-inline-start: 2px solid var(--rule);
  }
  .watch b { display: block; font-weight: 600; }
  .watch span { display: block; color: var(--muted); font-size: var(--fs-small); margin-block-start: var(--s1); }

  .related { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s3); }
  .rel {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    padding: var(--s5);
    text-decoration: none;
  }
  .rel:hover { border-color: var(--accent); }
  .rel b { display: block; }
  .rel span { display: block; font-size: var(--fs-small); color: var(--muted); margin-block-start: var(--s2); }

  .aside { position: sticky; top: 96px; display: grid; gap: var(--s4); }
  .panel {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    padding: var(--s5);
    box-shadow: var(--shadow-card);
  }
  .panel h2 { font-size: var(--fs-title); font-weight: 600; }
  .panel-lead { font-size: var(--fs-small); color: var(--muted); margin-block-start: var(--s3); }
  .panel-btn { width: 100%; margin-block-start: var(--s3); }
  .facts { margin-block-start: var(--s5); }
  .facts li {
    display: flex;
    justify-content: space-between;
    gap: var(--s3);
    font-size: var(--fs-small);
    padding-block: var(--s3);
    border-block-start: 1px solid var(--rule);
  }
  .facts .k { color: var(--muted); }
  .facts .v { font-weight: 600; font-variant-numeric: tabular-nums; text-align: end; }
  .facts a { display: inline-block; padding-block: 4px; }

  @media (max-width: 940px) {
    .body-grid { grid-template-columns: 1fr; gap: var(--s7); }
    .aside { position: static; }
    .related { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .cta-row { flex-direction: column; align-items: stretch; }
  }
</style>
